# Local development only. Never commit .env or real credentials.
DEBUG=True
SECRET_KEY=local-development-only-not-for-deployment
DATABASE_URL=
SITE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
INDEXABLE=false
STAGING=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CONTACT_NOTIFICATION_EMAIL=
# Render production values and optional Brevo SMTP configuration:
# See PRODUCTION_READINESS.md for the complete environment list.
# Remove MEDIA_ROOT when no persistent disk is mounted; bundled media is the default.
# Production must use a strong SECRET_KEY, PostgreSQL DATABASE_URL and HTTPS SITE_URL.
# Do not copy the local console EMAIL_BACKEND to production.

# Production overrides (replace placeholders in Render, not in Git):
# DEBUG=False
# SECRET_KEY=<random-secret-of-at-least-50-characters>
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# SITE_URL=https://euroafrica-1u37.onrender.com
# ALLOWED_HOSTS=euroafrica-1u37.onrender.com
# CSRF_TRUSTED_ORIGINS=https://euroafrica-1u37.onrender.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=<Brevo-SMTP-login>
# EMAIL_HOST_PASSWORD=<Brevo-SMTP-key-not-API-key>
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=<verified-sender-at-your-domain>
# SERVER_EMAIL=<verified-sender-at-your-domain>
# CONTACT_NOTIFICATION_EMAIL=<owner-inbox>
# Optional: GSC_VERIFICATION=<Google-verification-token>
# Optional authenticated staging: STAGING=true plus STAGING_USER and STAGING_PASSWORD.
# HSTS_INCLUDE_SUBDOMAINS=false and HSTS_PRELOAD=false until explicitly reviewed.
# Render supplies RENDER=true and PORT; no manual values needed.

# Required before production enquiries can be accepted (keys from Cloudflare Turnstile).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Site key is public; secret key is private. Managed widget, hostname from SITE_URL.
# No keys + DEBUG=True: local development only, remaining anti-spam checks stay active.
# No keys + DEBUG=False: submissions fail closed; the rest of the site still starts.
