# Local defaults. Never commit the populated .env file.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
SITE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
# Leave blank ONLY for local SQLite. Production requires PostgreSQL.
DATABASE_URL=
# DATABASE_URL=postgresql://euroafrica:URL_ENCODED_PASSWORD@127.0.0.1:5432/euroafrica
# Launch explicitly: INDEXABLE=true only on the final public domain.
INDEXABLE=false
STAGING=false
# Required when STAGING=true; also protect static/media at the reverse proxy.
STAGING_USER=
STAGING_PASSWORD=
# Search Console HTML verification token, not the full HTML tag.
GSC_VERIFICATION=
# Production only: true when Nginx overwrites forwarding headers and Gunicorn is loopback-only.
TRUST_LOCAL_PROXY=false
# Optional. Without ENQUIRY_EMAIL, submissions are saved without notification.
ENQUIRY_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
# Persistent absolute directory on production, outside release folders.
MEDIA_ROOT=
# Opt in only after every subdomain has HTTPS. Preload requires a separate deliberate submission.
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
