# Render sets RENDER=true automatically; Django then trusts Render's HTTPS proxy.
# Set these values in the Render dashboard (no square brackets or quotation marks):
# DEBUG=False
# ALLOWED_HOSTS=euroafrica-1u37.onrender.com
# SITE_URL=https://euroafrica-1u37.onrender.com
# CSRF_TRUSTED_ORIGINS=https://euroafrica-1u37.onrender.com
# MEDIA_ROOT=/var/data/media  (requires a Render persistent disk mounted at /var/data)
# CSRF_TRUSTED_ORIGINS accepts comma-separated HTTPS origins; default is SITE_URL.
